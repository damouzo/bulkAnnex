/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    bulkAnnex — per-module ext.args overrides
    Use this file to pass extra arguments to specific processes without touching
    the module definitions.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    withName: 'SINGULARITY_PULL' {
        // This process pulls the container — it must run natively (no container).
        container = null
    }
    withName: 'INPUT_CHECK' {
        // validated_*.csv → pipeline_info/ ; README.txt → outdir root
        publishDir = [
            [
                path: { "${params.outdir}/pipeline_info" },
                mode: 'copy',
                pattern: 'validated_*.csv'
            ],
            [
                path: { "${params.outdir}" },
                mode: 'copy',
                pattern: 'README.txt'
            ]
        ]
    }
    withName: 'DESEQ2_QC' {
        // qc_* → qc/ ; raw counts → counts/raw/
        publishDir = [
            [
                path: { "${params.outdir}/qc" },
                mode: 'copy',
                pattern: 'qc_*'
            ],
            [
                path: { "${params.outdir}/counts/raw" },
                mode: 'copy',
                pattern: 'raw_counts.tsv'
            ]
        ]
    }
    withName: 'DESEQ2_NORMALIZATION' {
        ext.args   = { "--min_counts ${params.min_counts} --min_samples ${params.min_samples}" }
        // One DESeq2 output set per norm_group → counts/norm/<group>/
        // (flat counts/norm/ when norm_group == 'all')
        publishDir = [
            [
                path: { meta.norm_group == 'all'
                    ? "${params.outdir}/counts/norm"
                    : "${params.outdir}/counts/norm/${meta.norm_group}" },
                mode: 'copy',
                pattern: '*.{csv,rds,tsv}'
            ]
        ]
    }
    withName: 'DESEQ2_DGE' {
        ext.args   = { "--alpha ${params.padj_threshold} --lfc_thresh ${params.lfc_threshold} --n_top ${params.dge_top_n} --n_top_extra ${params.dge_top_n_extra}" }
        publishDir = [
            path: { "${params.outdir}/dge/${meta.contrast_id}" },
            mode: 'copy',
            pattern: '*.{csv,rds,pdf,png,txt}'
        ]
    }
    withName: 'GSEA_ANALYSIS' {
        ext.args   = { "--pval_cutoff ${params.gsea_pval_cutoff} --min_gs ${params.gsea_min_gs_size} --max_gs ${params.gsea_max_gs_size}" }
        publishDir = [
            path: { "${params.outdir}/gsea/${meta.contrast_id}" },
            mode: 'copy',
            pattern: '*.{csv,pdf,png,rds}'
        ]
    }
    withName: 'GSEA_TREEDOT' {
        ext.args   = {
            "--databases  ${params.treedot_databases} " +
            "--top_paths  ${params.treedot_top_paths} " +
            "--clust_num  ${params.treedot_clust_num} " +
            "--ora_type   ${params.treedot_ora_type} " +
            "--ora_ont    ${params.treedot_ora_ont} " +
            "--ora_min_gs ${params.treedot_ora_min_gs} " +
            "--ora_max_gs ${params.treedot_ora_max_gs} " +
            "--ora_padj   ${params.treedot_ora_padj} " +
            "--min_gs     ${params.gsea_min_gs_size} " +
            "--max_gs     ${params.gsea_max_gs_size}"
        }
        publishDir = [
            path: { "${params.outdir}/gsea/treedot" },
            mode: 'copy',
            pattern: '*.{pdf,png,rds}'
        ]
    }
    withName: 'CONTRAST_COMPARISON' {
        ext.args   = { "--padj ${params.comparison_padj} --lfc ${params.comparison_lfc}" }
        publishDir = [
            path: { "${params.outdir}/dge/contrast_comparison" },
            mode: 'copy',
            pattern: '*.{pdf,png,csv}'
        ]
    }
    withName: 'SHINY_DASHBOARD' {
        publishDir = [
            path: { "${params.outdir}" },
            mode: 'copy'
        ]
    }
}
